# Cache shell-specific jenv init output, but keep JAVA_HOME hooks live.
_profile_jenv_init() {
    local shell cache_file now mtime age key saved_key script line ref valid tmp_file
    local binary root dep metadata
    if [ -n "${ZSH_VERSION-}" ]; then
        setopt localoptions nonomatch
        shell=zsh
        binary=$(whence -p jenv)
    else
        shell=bash
        binary=$(type -P jenv)
    fi
    root="${JENV_ROOT:-$HOME/.jenv}"
    cache_file="${XDG_CACHE_HOME}/jenv-init-${shell}"
    now=$(date +%s)
    # Track executable/plugin identity as well as modification time. Symlink
    # targets change on Homebrew upgrades even if timestamps are preserved.
    key="$root|$binary|${JENV_HOOK_PATH-}"
    for dep in "$binary" "$root/plugins" "$root"/plugins/*; do
        [ -e "$dep" ] || continue
        metadata=$(stat -L -f "%d:%i:%m:%z" "$dep" 2>/dev/null) ||
            metadata=$(stat -L -c "%d:%i:%Y:%s" "$dep" 2>/dev/null) || metadata=unknown
        key="$key|$dep:$metadata"
    done
    valid=false
    if [ -r "$cache_file" ]; then
        IFS= read -r saved_key < "$cache_file"
        mtime=$(stat -f %m "$cache_file" 2>/dev/null) ||
            mtime=$(stat -c %Y "$cache_file" 2>/dev/null) || mtime=0
        age=$((now - mtime))
        if [ "$saved_key" = "# cache-key: $key" ] &&
            [ "$age" -ge 0 ] && [ "$age" -lt 43200 ]; then
            valid=true
            while IFS= read -r line; do
                case "$line" in
                    source\ *)
                        # jenv emits source paths enclosed in single/double quotes.
                        ref=${line#source }
                        ref=${ref#?}; ref=${ref%?}
                        if [ ! -r "$ref" ] || [ "$ref" -nt "$cache_file" ]; then
                            valid=false
                            break
                        fi
                        ;;
                esac
            done < "$cache_file"
        fi
    fi
    if [ "$valid" = true ]; then
        . "$cache_file"
        return
    fi
    # Refresh links before generating the script; never cache this command.
    if command jenv refresh-plugins &&
        script=$(command jenv init - --no-rehash "$shell"); then
        tmp_file=""
        if mkdir -p "$XDG_CACHE_HOME" 2>/dev/null; then
            tmp_file=$(mktemp "${cache_file}.XXXXXX" 2>/dev/null) || tmp_file=""
        fi
        if [ -n "$tmp_file" ]; then
            if {
                printf "# cache-key: %s\n" "$key"
                while IFS= read -r line; do
                    [ "$line" = "jenv refresh-plugins" ] || printf "%s\n" "$line"
                done <<EOF
$script
EOF
            } > "$tmp_file" && mv -f "$tmp_file" "$cache_file" 2>/dev/null; then
                . "$cache_file"
                return
            fi
            rm -f "$tmp_file"
        fi
        eval "$script"
    else
        eval "$(command jenv init - --no-rehash "$shell")"
    fi
}
_profile_jenv_init
unset -f _profile_jenv_init

# init python uv
source "${HOME}/.local/bin/env"

# init go
export GOROOT="/usr/local/go"
export GOPATH="${HOME}/go"
export GOBIN="${GOPATH}/bin"

# init node
export NVM_DIR="${HOME}/.config/nvm"
[ -s "${NVM_DIR}/nvm.sh" ] && \. "${NVM_DIR}/nvm.sh" --no-use

# Zsh completion must load after Oh My Zsh has initialized compinit.
# Register once before the first prompt; Bash can load it immediately.
case $- in
    *i*)
        if [ -n "${ZSH_VERSION-}" ]; then
            _profile_nvm_completion() {
                precmd_functions=("${(@)precmd_functions:#_profile_nvm_completion}")
                [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
                unfunction _profile_nvm_completion
            }
            typeset -ga precmd_functions
            if (( ! ${precmd_functions[(Ie)_profile_nvm_completion]} )); then
                precmd_functions+=(_profile_nvm_completion)
            fi
        elif [ -n "${BASH_VERSION-}" ]; then
            [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
        fi
        ;;
esac

# load local secrets (not tracked in dotfiles; see ~/.keychain, chmod 600)
[ -f ~/.keychain ] && source ~/.keychain

