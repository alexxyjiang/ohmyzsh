# init path
export GO_BIN_PATH="${GOROOT}/bin:${GOBIN}"
export LLVM_BIN_PATH="/opt/homebrew/opt/llvm/bin"
# Cache the resolved default Node bin directory for 12 hours. Keep resolving
# `default` on refresh so newly installed matching versions are picked up.
export NODE_BIN_PATH="$(
    cache_file="${XDG_CACHE_HOME}/node-default-bin"
    now=$(date +%s)
    mtime=0
    cached_bin=""
    if [ -f "$cache_file" ]; then
        IFS= read -r cached_bin < "$cache_file"
        mtime=$(stat -f %m "$cache_file" 2>/dev/null) ||
            mtime=$(stat -c %Y "$cache_file" 2>/dev/null) || mtime=0
    fi
    age=$((now - mtime))
    if [ "$age" -ge 0 ] && [ "$age" -lt 43200 ] &&
        [ -x "$cached_bin/node" ] &&
        [ ! "${NVM_DIR}/alias/default" -nt "$cache_file" ]; then
        printf "%s\n" "$cached_bin"
    else
        node_path=$(nvm which default) || exit 1
        [ -x "$node_path" ] || exit 1
        node_bin=${node_path%/*}
        # A read-only cache must not prevent Node from becoming available.
        if mkdir -p "${XDG_CACHE_HOME}" 2>/dev/null; then
            tmp_file=$(mktemp "${cache_file}.XXXXXX" 2>/dev/null) || tmp_file=""
            if [ -n "$tmp_file" ]; then
                if printf "%s\n" "$node_bin" > "$tmp_file"; then
                    mv -f "$tmp_file" "$cache_file" 2>/dev/null || rm -f "$tmp_file"
                else
                    rm -f "$tmp_file"
                fi
            fi
        fi
        printf "%s\n" "$node_bin"
    fi
)"
